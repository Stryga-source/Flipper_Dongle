CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_GATT_CLIENT=y

CONFIG_TINYUSB_HID_COUNT=1
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="Flipper Dongle Project"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="Flipper Dongle v0.4.4 Debug"
CONFIG_TINYUSB_DESC_SERIAL_STRING="FD044"
CONFIG_TINYUSB_DESC_CDC_STRING="Flipper Dongle Debug"

CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Persist BLE bonding keys across reboots.
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=4

# ESP-IDF 6.1 quirk: nimble_hidh.c gates BLE HID Host symbols behind
# CONFIG_BT_NIMBLE_HID_SERVICE. Keep GATT server/peripheral enabled so this
# Kconfig option is selectable.
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_HID_SERVICE=y

# Make the SMP compile-time capabilities explicit for ESP-IDF 6.1.
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SM_SC_ONLY=0
